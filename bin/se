#!/usr/bin/env bash
# se — deterministic status board for worktree-per-feature development.
# Part of the staff-engineer (se) Claude Code plugin. No LLM involved:
# everything printed comes from durable on-disk state (git, docs/plan/,
# ~/.claude/projects session transcripts), so it is correct after a reboot.
# Live claude processes are an optional overlay, never the source of truth.
#
# usage: se [status|env|baseline|teardown <name>|debt|help]
#
#   SE_COLOR=auto|always|never
#                     color the output; auto (default) colors only when
#                     stdout is a tty and NO_COLOR is unset; always/never
#                     force it on or off.
#
#   status            status board (default): worktrees, TODO progress,
#                     resume commands, anomalies. The resume list is a
#                     numbered menu; when stdin+stdout are both a tty it
#                     prompts to join or start a session there. Set
#                     SE_NO_PROMPT=1 to always skip the prompt (also
#                     skipped automatically when not interactive).
#
#                     Sessions are grouped under the checkout they worked in,
#                     which is not always the one storing their transcript: a
#                     session that entered a worktree is listed there, marked
#                     "started from <dir>". Each checkout shows its 3 newest
#                     sessions, read from the 8 newest transcripts in its
#                     project folder — anything older is not offered.
#   env               set up this checkout from docs/architecture/worktree.json
#                     (copy files, symlink dirs, postCreate hooks, ignore
#                     check). Idempotent.
#   baseline          run worktree.json's baseline commands, record
#                     PASS/FAIL + duration + output tail to
#                     scratchpad/baseline.md
#   teardown <name>   remove .claude/worktrees/<name> once merged, clean, and
#                     free of irreplaceable files: preDelete hooks, worktree
#                     remove, branch -d, prune. No force flag exists.
#   debt              scan for `se-debt: <ceiling>, <trigger>` markers in
#                     comments; report file:line + text, flag ones missing
#                     a trigger, and print a summary. Exit 0 always.
#   help              this text
set -u

case "${1:-status}" in
  status|env|baseline|teardown|debt) ;;
  help|-h|--help)
    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    echo "se: unknown command '${1}' (try: se help)" >&2
    exit 2
    ;;
esac

# Color: SE_COLOR=auto (default) emits SGR only when stdout is a tty and
# NO_COLOR (https://no-color.org) is unset/empty; always/never force it on
# or off. Defined once as either the escape sequence or the empty string, so
# every call site is unconditional — "$C_GREEN$text$C_RESET" prints plain
# text when color is off. Portable 16-color SGR only (no 256-color/
# truecolor), so the terminal theme picks the exact shade.
case "${SE_COLOR:-auto}" in
  always) use_color=1 ;;
  never)  use_color=0 ;;
  *)      if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then use_color=1; else use_color=0; fi ;;
esac
if [ "$use_color" = "1" ]; then
  C_RESET=$'\033[0m'  C_BOLD=$'\033[1m'   C_DIM=$'\033[2m'
  C_RED=$'\033[31m'   C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_CYAN=$'\033[36m'
else
  C_RESET='' C_BOLD='' C_DIM='' C_RED='' C_GREEN='' C_YELLOW='' C_CYAN=''
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "se: not inside a git repository" >&2
  exit 1
}

# Base branch: origin/HEAD if set, else main.
base=$(git -C "$root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
base=${base:-main}
if git -C "$root" rev-parse --verify -q "origin/$base" >/dev/null 2>&1; then
  baseref="origin/$base"
else
  baseref="$base"
fi

now=$(date +%s)

mtime_epoch() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null; }

rel_age() { # epoch -> 5m / 3h / 2d
  local diff=$(( now - ${1:-0} ))
  if   [ "$diff" -lt 3600 ];  then printf '%dm' $((diff / 60))
  elif [ "$diff" -lt 86400 ]; then printf '%dh' $((diff / 3600))
  else                             printf '%dd' $((diff / 86400))
  fi
}

# ASCII only in aligned columns: printf pads by bytes, so multibyte
# glyphs (arrows, ellipses) silently break the table.
# True when any path SEGMENT is rebuildable noise, at any depth — a
# monorepo's packages/*/node_modules must not read as precious.
is_rebuildable() { # relative path
  local seg IFS=/
  for seg in $1; do
    case "$seg" in
      node_modules|.next|dist|build|.turbo|coverage|.venv|__pycache__|.pnpm-store|.cache|scratchpad)
        return 0 ;;
    esac
  done
  return 1
}

# Claude Code stores each directory's transcripts under
# ~/.claude/projects/<encoded path>. The encoding flattens more than `/` and
# `.`: a worktree named `fix+mobile-keyboard-and-touch` is stored with the
# `+` as `-` too, so the obvious tr '/.' '--' silently misses its sessions
# and the board claims the worktree is fresh. Try the narrow encoding first,
# then the flatten-everything-else one, and only trust the looser match when
# a transcript's own `cwd` says it really is this directory.
session_dir() { # absolute path -> project dir (may not exist)
  local p=$1 strict loose base
  base="${HOME:-}/.claude/projects"
  strict=$(printf '%s' "$p" | tr '/.' '--')
  if [ -d "$base/$strict" ]; then printf '%s' "$base/$strict"; return 0; fi
  loose=$(printf '%s' "$p" | sed 's/[^A-Za-z0-9]/-/g')
  if [ "$loose" != "$strict" ] && [ -d "$base/$loose" ]; then
    local newest
    newest=$(/bin/ls -t "$base/$loose" 2>/dev/null | grep '\.jsonl$' | head -1)
    if [ -n "$newest" ] && grep -qF "\"cwd\":\"$p\"" "$base/$loose/$newest" 2>/dev/null; then
      printf '%s' "$base/$loose"; return 0
    fi
  fi
  printf '%s' "$base/$strict"
}

trunc() { # string maxlen
  local s=$1 n=$2
  if [ "${#s}" -gt "$n" ]; then printf '%s~' "${s:0:$((n - 1))}"; else printf '%s' "$s"; fi
}

# The worktree a session actually worked in, or nothing. Claude Code keeps
# writing a session's transcript to the project folder for the directory it
# was LAUNCHED from — it never moves or copies it when the session enters a
# worktree. The move is recorded inline instead: one `worktree-state` record
# on the way in naming the worktree, and the same record with a null payload
# on the way out. The LAST NON-NULL one is the answer; the final record is
# usually the null, because most sessions leave the worktree before ending.
session_worktree() { # transcript -> worktree path, or nothing
  local states last
  states=$(grep '"type":"worktree-state"' "$1" 2>/dev/null)
  [ -n "$states" ] || return 0
  last=$(printf '%s\n' "$states" | grep -v '"worktreeSession":null' | tail -1)
  [ -n "$last" ] || return 0
  printf '%s' "$last" | sed -E 's/.*"worktreePath":"([^"]*)".*/\1/'
}

# Index into paths[] of the checkout at $1, or the fallback $2 when nothing
# matches — usually a worktree torn down since the session ran, which must
# fall back to the folder storing the transcript rather than vanish. git
# reports fully resolved paths (macOS /var -> /private/var) while a transcript
# records the path as the session saw it, so try both forms.
checkout_of() { # path fallback-index -> index
  local want=$1 fb=$2 k real
  [ -n "$want" ] || { printf '%s' "$fb"; return 0; }
  real=$(cd "$want" 2>/dev/null && pwd -P) || real=""
  for ((k = 0; k < ${#paths[@]}; k++)); do
    if [ "${paths[$k]}" = "$want" ] || { [ -n "$real" ] && [ "${paths[$k]}" = "$real" ]; }; then
      printf '%s' "$k"; return 0
    fi
  done
  printf '%s' "$fb"
}

# Single python entry point for docs/architecture/worktree.json. Two modes,
# selected by argv[1]:
#   shape <file>              -> OK / EMPTY / OLD / UNREADABLE (never fails)
#   records <file> <section>  -> one KIND\tVALUE\tWHY\tREQUIRED line per
#                                 entry (KIND: path/run/check); prints
#                                 nothing when the file/section is absent.
#                                 A malformed entry (object with none of
#                                 run/path/check) is fatal: message on
#                                 stderr naming the file + entry index,
#                                 exit 2 — every caller checks $? right after
#                                 capturing this with `$(...)`.
wt_json_py() {
  python3 - "$@" <<'PY'
import json, sys

CANONICAL = ["copy", "symlink", "postCreate", "preDelete", "baseline"]

def clean(s):
    return str(s).replace("\t", " ").replace("\n", " ")

def normalize(file, section, item, idx):
    if isinstance(item, str):
        kind = "path" if section in ("copy", "symlink") else "run"
        return kind, item, "", ""
    if isinstance(item, dict):
        why = item.get("why") or ""
        if "path" in item:
            kind, value = "path", item["path"]
        elif "run" in item:
            kind, value = "run", item["run"]
        elif "check" in item:
            kind, value = "check", item["check"]
        else:
            sys.stderr.write(
                "se: malformed entry in %s: '%s' item %d has none of "
                "run/path/check\n" % (file, section, idx)
            )
            sys.exit(2)
        required = "1" if item.get("required") else ""
        return kind, value, why, required
    sys.stderr.write(
        "se: malformed entry in %s: '%s' item %d is not a string or "
        "object\n" % (file, section, idx)
    )
    sys.exit(2)

mode = sys.argv[1] if len(sys.argv) > 1 else ""

if mode == "shape":
    file = sys.argv[2]
    try:
        with open(file) as fh:
            data = json.load(fh)
    except Exception:
        data = None
    if not isinstance(data, dict):
        print("UNREADABLE")
        sys.exit(0)
    old = "sync" in data or "hooks" in data or isinstance(data.get("baseline"), dict)
    if old:
        print("OLD")
        sys.exit(0)
    total = sum(len(data[k]) for k in CANONICAL if isinstance(data.get(k), list))
    print("OK" if total > 0 else "EMPTY")
    sys.exit(0)

if mode == "records":
    file, section = sys.argv[2], sys.argv[3]
    try:
        with open(file) as fh:
            data = json.load(fh)
    except Exception:
        sys.exit(0)
    if not isinstance(data, dict):
        sys.exit(0)
    items = data.get(section)
    if not isinstance(items, list):
        sys.exit(0)
    for i, item in enumerate(items):
        kind, value, why, required = normalize(file, section, item, i)
        print("\t".join(clean(f) for f in (kind, value, why, required)))
    sys.exit(0)

sys.exit(0)
PY
}

# Branches already merged into base (evaluated from the main checkout).
merged_list=$(git -C "$root" branch --format='%(refname:short)' --merged "$baseref" 2>/dev/null)
is_merged() { printf '%s\n' "$merged_list" | grep -qFx "$1"; }

# A tip on base's first-parent chain never diverged (fresh branch, or
# fast-forwarded); a truly merged branch's tip is reachable only through a
# merge commit's second parent.
mainline=$(git -C "$root" rev-list --first-parent -n 2000 "$baseref" 2>/dev/null)
in_mainline() { printf '%s\n' "$mainline" | grep -qx "$1"; }

# Shared "safe to tear down" test: merged into base AND its tip actually
# left base's first-parent chain (a real merge commit exists). Used by both
# the status board's anomaly line and `se teardown`'s hard merge gate.
is_branch_merged() {
  is_merged "$1" || return 1
  local tip
  tip=$(git -C "$root" rev-parse -q --verify "refs/heads/$1" 2>/dev/null) || return 1
  ! in_mainline "$tip"
}

# Parse worktrees: paths[] / branches[] in `git worktree list` order — the
# first entry is always the main checkout, regardless of which checkout $root
# points at.
paths=() branches=()
cur=""
while IFS= read -r line; do
  case "$line" in
    "worktree "*) cur=${line#worktree } ;;
    "branch refs/heads/"*) paths+=("$cur"); branches+=("${line#branch refs/heads/}") ;;
    detached) paths+=("$cur"); branches+=("(detached)") ;;
  esac
done < <(git -C "$root" worktree list --porcelain)
main_checkout=${paths[0]:-$root}

# Launch Claude Code for one resume-menu row. n: 1-based index into the
# resume_* arrays cmd_status built, already in display order. mode: "join"
# (that row's saved session, falling back to a fresh session when it has none
# — same as the row's own printed text) or "new" (always a fresh session).
#
# Joining always names the session id rather than using --continue: a row's
# session is not necessarily the newest transcript in the directory we launch
# in, so --continue would open a different conversation.
resume_launch() {
  local n=$1 mode=$2 idx p id
  idx=$((n - 1))
  p=${resume_paths[$idx]}
  id=${resume_ids[$idx]}
  [ "$mode" = "join" ] || id=""

  if ! command -v claude >/dev/null 2>&1; then
    if [ -n "$id" ]; then
      echo "se: claude not found on PATH — run this yourself: cd $p && claude --resume $id" >&2
    else
      echo "se: claude not found on PATH — run this yourself: cd $p && claude" >&2
    fi
    exit 1
  fi

  if [ -n "$id" ]; then
    printf '→ cd %s && claude --resume %s\n' "$p" "$id"
    cd "$p" || exit 1
    exec claude --resume "$id"
  else
    printf '→ cd %s && claude\n' "$p"
    cd "$p" || exit 1
    exec claude
  fi
}

cmd_status() {
  # Live overlay: cwds of running claude sessions (empty after reboot — fine).
  running_cwds=""
  if command -v claude >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    running_cwds=$(claude agents --json 2>/dev/null | python3 -c '
import json, sys
try:
    for a in json.load(sys.stdin):
        # Only interactive sessions count as "running": background agents
        # report the directory they were launched from and are often blocked
        # leftovers, so counting them marks checkouts nobody is sitting in.
        if a.get("kind", "interactive") == "background": continue
        c = a.get("cwd")
        if c: print(c)
except Exception:
    pass
' 2>/dev/null)
  fi
  is_running() { printf '%s\n' "$running_cwds" | grep -qFx "$1"; }

  printf '%sse · repo: %s · base: %s · %d worktree(s)%s\n\n' \
    "$C_BOLD" "$(basename "$root")" "$base" "${#paths[@]}" "$C_RESET"
  printf -v hdrrow '%-26s %-14s %-6s %-32s %s' "BRANCH" "GIT" "TODO" "NEXT STEP" "LAST SESSION"
  printf '%s%s%s\n' "$C_DIM" "$hdrrow" "$C_RESET"

  anomalies=()

  # Decided once, up front: it selects both the resume-row format and
  # whether the picker runs. A real terminal on both ends, not suppressed.
  will_prompt=0
  if [ -t 0 ] && [ -t 1 ] && [ -z "${SE_NO_PROMPT:-}" ]; then will_prompt=1; fi

  # --- pre-pass: gather sessions and work out whose they really are ---------
  # Every session is described once, in flat parallel arrays (bash 3.2 here
  # and on CI, so no associative arrays): where its transcript is stored, and
  # which checkout it belongs to. The two differ whenever a session was
  # launched in one directory and did its work in a worktree.
  #
  # Reading a folder's SESS_READ newest transcripts measures ~57ms; reading
  # every one of them ~620ms, too slow for a board that should feel instant.
  # A session older than a folder's SESS_READ newest is not offered.
  SESS_READ=8
  SESS_SHOW=3

  sess_id=() sess_when=() sess_title=() sess_owner=() sess_home=()
  for ((i = 0; i < ${#paths[@]}; i++)); do
    d=$(session_dir "${paths[$i]}")
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      t=$(grep -m1 -o '"aiTitle":"[^"]*"' "$d/$f" 2>/dev/null | sed 's/"aiTitle":"//; s/"$//')
      [ -n "$t" ] || t="(untitled)"
      sess_id+=("${f%.jsonl}")
      sess_when+=("$(mtime_epoch "$d/$f")")
      sess_title+=("$t")
      sess_owner+=("$i")
      sess_home+=("$(checkout_of "$(session_worktree "$d/$f")" "$i")")
    done < <(/bin/ls -t "$d" 2>/dev/null | grep '\.jsonl$' | head -"$SESS_READ")
  done

  for ((i = 0; i < ${#paths[@]}; i++)); do
    p=${paths[$i]} b=${branches[$i]}

    # --- git state ---
    dirty=$(git -C "$p" status --porcelain 2>/dev/null | grep -c .)
    gitcol="clean" gitcolor="$C_GREEN"
    [ "$dirty" -gt 0 ] && gitcol="dirty:$dirty" && gitcolor="$C_YELLOW"
    ab=$(git -C "$p" rev-list --left-right --count "$baseref...HEAD" 2>/dev/null)
    behind=${ab%%	*} ahead=${ab##*	}
    [ "${ahead:-0}" -gt 0 ] 2>/dev/null && gitcol="$gitcol +$ahead"
    [ "${behind:-0}" -gt 0 ] 2>/dev/null && gitcol="$gitcol -$behind"
    commit_epoch=$(git -C "$p" log -1 --format=%ct 2>/dev/null || echo 0)

    # --- plan TODO progress ---
    todo="-" next="-" todocolor="$C_DIM"
    if [ "$b" != "$base" ] && [ "$b" != "(detached)" ]; then
      # The documented name is `docs/plan/<branch>.md`, but a branch carries
      # characters a filename usually does not: Claude Code's own worktrees
      # produce branches like `worktree-fix+mobile-keyboard-and-touch`, whose
      # plan gets written with the `+` flattened. Try the exact name, then the
      # flattened one, before falling back to "there is only one plan here".
      plan="$p/docs/plan/$(printf '%s' "$b" | tr '/' '-').md"
      if [ ! -f "$plan" ]; then
        flat="$p/docs/plan/$(printf '%s' "$b" | sed 's/[^A-Za-z0-9._-]/-/g').md"
        [ -f "$flat" ] && plan="$flat"
      fi
      if [ ! -f "$plan" ]; then
        cand=$(/bin/ls "$p/docs/plan" 2>/dev/null | grep '\.md$' | grep -vi '^readme')
        [ "$(printf '%s\n' "$cand" | grep -c .)" = "1" ] && plan="$p/docs/plan/$cand"
      fi
      if [ -f "$plan" ]; then
        done_n=$(grep -cE '^[[:space:]]*- \[x\]' "$plan")
        open_n=$(grep -cE '^[[:space:]]*- \[ \]' "$plan")
        todo="$done_n/$((done_n + open_n))"
        if [ "$done_n" -eq "$((done_n + open_n))" ]; then todocolor="$C_GREEN"; else todocolor="$C_YELLOW"; fi
        next=$(grep -m1 -E '^[[:space:]]*- \[ \]' "$plan" | sed -E 's/^[[:space:]]*- \[ \] *//')
        [ -n "$next" ] || next="all done"
      else
        anomalies+=("$b — no plan file in docs/plan/ → start one with /se:plan")
      fi
    fi

    # --- saved sessions (durable; survives reboot) ---
    # The newest session ATTRIBUTED to this checkout, which is not always one
    # stored in its own folder — so this column and the grouped resume list
    # below always tell the same story.
    sess="none — fresh" last_epoch=0
    newest_idx=-1
    for ((k = 0; k < ${#sess_id[@]}; k++)); do
      [ "${sess_home[$k]}" = "$i" ] || continue
      if [ "$newest_idx" = "-1" ] || [ "${sess_when[$k]}" -gt "${sess_when[$newest_idx]}" ]; then
        newest_idx=$k
      fi
    done
    if [ "$newest_idx" != "-1" ]; then
      last_epoch=${sess_when[$newest_idx]}
      sess="$(rel_age "$last_epoch") · $(trunc "${sess_title[$newest_idx]}" 34)"
    fi
    is_running "$p" && sess="$sess ${C_GREEN}● running${C_RESET}"

    # Pad first, then colorize: printf pads by bytes, so wrapping a value in
    # escape codes before padding would silently break the table.
    printf -v branchpad '%-26s' "$(trunc "$b" 26)"
    printf -v gitpad '%-14s' "$gitcol"
    printf -v todopad '%-6s' "$todo"
    printf -v nextpad '%-32s' "$(trunc "$next" 32)"
    printf '%s %s%s%s %s%s%s %s %s\n' \
      "$branchpad" \
      "$gitcolor" "$gitpad" "$C_RESET" \
      "$todocolor" "$todopad" "$C_RESET" \
      "$nextpad" "$sess"

    # --- anomalies ---
    # "Merged" needs care: a freshly created branch's tip is reachable from
    # base too. Flag teardown only on real signals — the tip left base's
    # first-parent chain (a real merge commit exists), or the plan's TODO is
    # fully ticked (covers the fast-forward-merge case).
    if [ "$b" != "$base" ] && [ "$b" != "(detached)" ]; then
      wtname=$(basename "$p")
      if is_branch_merged "$b"; then
        if [ "$dirty" -gt 0 ]; then
          anomalies+=("$b — MERGED but worktree has $dirty uncommitted file(s): inspect before anything else, never discard")
        else
          anomalies+=("$b — merged into $base but worktree still exists → run \`se teardown $wtname\`")
        fi
      elif is_merged "$b" && [ "$next" = "all done" ]; then
        anomalies+=("$b — TODO complete and branch merged → run \`se teardown $wtname\`")
      fi
    fi
    if [ "$b" = "(detached)" ]; then
      anomalies+=("$(basename "$p") — detached HEAD: no branch/plan mapping")
    fi
    if [ "$b" != "$base" ] && [ "$commit_epoch" -lt $((now - 604800)) ] && [ "$last_epoch" -lt $((now - 604800)) ]; then
      anomalies+=("$b — stale: no commits or sessions in 7+ days — abandoned?")
    fi
  done

  if [ "${#anomalies[@]}" -gt 0 ]; then
    printf '\n%sAnomalies:%s\n' "$C_BOLD" "$C_RESET"
    for ((i = 0; i < ${#anomalies[@]}; i++)); do
      # Red for anything about losing work, yellow for every other anomaly.
      acolor="$C_YELLOW"
      case "${anomalies[$i]}" in
        *"uncommitted file(s)"*) acolor="$C_RED" ;;
      esac
      printf '  %s! %s%s\n' "$acolor" "${anomalies[$i]}" "$C_RESET"
    done
  fi

  # Resume list: sessions, grouped under the checkout they belong to. Groups
  # are ordered by their newest session, so the checkout you touched last is
  # on top — but a base checkout's long backlog can never push a worktree off
  # the list, which is what a flat time-ordered list would do. Checkouts with
  # no sessions sort last, on a newest of 0.
  group_order=()
  while IFS= read -r line; do group_order+=("${line#*	}"); done < <(
    for ((i = 0; i < ${#paths[@]}; i++)); do
      newest=0
      for ((k = 0; k < ${#sess_id[@]}; k++)); do
        [ "${sess_home[$k]}" = "$i" ] || continue
        [ "${sess_when[$k]}" -gt "$newest" ] && newest=${sess_when[$k]}
      done
      printf '%d\t%d\n' "$newest" "$i"
    done | sort -t $'\t' -k1,1nr -k2,2n
  )

  # One flat, continuously numbered list so the picker still acts on a plain
  # number; resume_head carries the heading to print before a row, if any.
  resume_paths=() resume_ids=() resume_head=() resume_row=()
  for gi in "${group_order[@]}"; do
    gp=${paths[$gi]}
    head=${branches[$gi]}
    [ "$head" = "(detached)" ] && head=$(basename "$gp")

    picked=()
    while IFS= read -r line; do picked+=("${line#*	}"); done < <(
      for ((k = 0; k < ${#sess_id[@]}; k++)); do
        [ "${sess_home[$k]}" = "$gi" ] || continue
        printf '%d\t%d\n' "${sess_when[$k]}" "$k"
      done | sort -t $'\t' -k1,1nr -k2,2n | head -"$SESS_SHOW"
    )

    if [ "${#picked[@]}" -eq 0 ]; then
      resume_paths+=("$gp")
      resume_ids+=("")
      resume_head+=("$head")
      if [ "$will_prompt" = "1" ]; then
        resume_row+=("${C_DIM}no saved session — starts fresh${C_RESET}")
      else
        resume_row+=("cd $gp && claude    # no saved session — starts fresh")
      fi
      continue
    fi

    for k in "${picked[@]}"; do
      # Only worth saying when the transcript is stored somewhere else: this
      # is the session that looked like it belonged to another checkout.
      from=""
      [ "${sess_owner[$k]}" != "$gi" ] && from="started from $(basename "${paths[${sess_owner[$k]}]}")"
      resume_paths+=("$gp")
      resume_ids+=("${sess_id[$k]}")
      resume_head+=("$head")
      if [ "$will_prompt" = "1" ]; then
        printf -v row '%4s  %s' "$(rel_age "${sess_when[$k]}")" "$(trunc "${sess_title[$k]}" 34)"
        [ -n "$from" ] && row="$row    ${C_DIM}${from}${C_RESET}"
      else
        row="cd $gp && claude --resume ${sess_id[$k]}    # $(rel_age "${sess_when[$k]}") · ${sess_title[$k]}"
        [ -n "$from" ] && row="$row — $from"
      fi
      resume_row+=("$row")
      head=""
    done
  done

  resume_count=${#resume_paths[@]}
  width=${#resume_count}
  printf '\n%sResume (most recent first):%s\n' "$C_BOLD" "$C_RESET"
  for ((n = 0; n < resume_count; n++)); do
    [ -n "${resume_head[$n]}" ] && printf '  %s%s%s\n' "$C_BOLD" "${resume_head[$n]}" "$C_RESET"
    printf -v numpad '%*d' "$width" "$((n + 1))"
    printf '    %s%s%s%s  %s\n' \
      "$C_BOLD" "$C_CYAN" "$numpad" "$C_RESET" "${resume_row[$n]}"
  done

  # Interactive picker: only when it is safe to prompt — a real terminal on
  # both stdin and stdout, and not explicitly suppressed. This keeps `se`
  # pipeable, scriptable and CI-safe: any redirect or SE_NO_PROMPT=1 falls
  # straight through to `exit 0` below, printing exactly the report above.
  if [ "$will_prompt" = "1" ] && [ "$resume_count" -gt 0 ]; then
    printf '\n'
    while :; do
      printf -v promptline 'Join [1-%d], n<%d> for a new session, q to quit: ' "$resume_count" "$resume_count"
      printf '%s%s%s' "$C_BOLD" "$promptline" "$C_RESET"
      IFS= read -r choice || exit 0
      case "$choice" in
        ''|q|Q) exit 0 ;;
        [nN]*)
          rest=${choice#?}
          rest=${rest# }
          case "$rest" in
            ''|*[!0-9]*) printf 'not a valid choice\n'; continue ;;
          esac
          if [ "$rest" -ge 1 ] && [ "$rest" -le "$resume_count" ]; then
            resume_launch "$rest" new
          else
            printf 'not a valid choice\n'
          fi
          ;;
        *)
          case "$choice" in
            *[!0-9]*) printf 'not a valid choice\n'; continue ;;
          esac
          if [ "$choice" -ge 1 ] && [ "$choice" -le "$resume_count" ]; then
            resume_launch "$choice" join
          else
            printf 'not a valid choice\n'
          fi
          ;;
      esac
    done
  fi

  exit 0
}

cmd_env() {
  wt_json="$root/docs/architecture/worktree.json"
  if [ ! -f "$wt_json" ]; then
    echo "no docs/architecture/worktree.json — nothing to do"
    exit 0
  fi

  case "$(wt_json_py shape "$wt_json")" in
    OLD)
      echo "se env: docs/architecture/worktree.json uses the old nested layout (sync/hooks/baseline.commands); rename to top-level copy/symlink/postCreate/preDelete/baseline" >&2
      exit 1
      ;;
    EMPTY|UNREADABLE)
      echo "se env: docs/architecture/worktree.json has no recognized entries — expected top-level keys: copy, symlink, postCreate, preDelete, baseline" >&2
      exit 1
      ;;
  esac

  main=$main_checkout

  # copy — untracked files the worktree needs, copied from main. A
  # required:true entry missing from main is fatal, not just reported.
  copy_records=$(wt_json_py records "$wt_json" copy); rc=$?
  [ "$rc" -eq 0 ] || exit 1
  while IFS=$'\t' read -r kind value why required; do
    [ "$kind" = "path" ] || continue
    [ -n "$value" ] || continue
    if [ -e "$root/$value" ]; then
      printf '%scopy %s: already present%s\n' "$C_DIM" "$value" "$C_RESET"
    elif [ -e "$main/$value" ]; then
      cp -p "$main/$value" "$root/$value"
      printf '%scopy %s: done%s\n' "$C_GREEN" "$value" "$C_RESET"
    elif [ "$required" = "1" ]; then
      printf '%scopy %s: missing in main (required)%s\n' "$C_YELLOW" "$value" "$C_RESET" >&2
      exit 1
    else
      printf '%scopy %s: missing in main%s\n' "$C_YELLOW" "$value" "$C_RESET"
    fi
  done < <(printf '%s\n' "$copy_records")

  # symlink — shared by symlink instead of reinstalling.
  symlink_records=$(wt_json_py records "$wt_json" symlink); rc=$?
  [ "$rc" -eq 0 ] || exit 1
  while IFS=$'\t' read -r kind value why required; do
    [ "$kind" = "path" ] || continue
    [ -n "$value" ] || continue
    if [ -e "$root/$value" ] || [ -L "$root/$value" ]; then
      printf '%ssymlink %s: already present%s\n' "$C_DIM" "$value" "$C_RESET"
    elif [ -e "$main/$value" ]; then
      ln -s "$main/$value" "$root/$value"
      printf '%ssymlink %s: done%s\n' "$C_GREEN" "$value" "$C_RESET"
    elif [ "$required" = "1" ]; then
      printf '%ssymlink %s: missing in main (required)%s\n' "$C_YELLOW" "$value" "$C_RESET" >&2
      exit 1
    else
      printf '%ssymlink %s: missing in main%s\n' "$C_YELLOW" "$value" "$C_RESET"
    fi
  done < <(printf '%s\n' "$symlink_records")

  # postCreate — run inside this checkout; a failure is fatal, since a
  # half-set-up worktree should stop the workflow, not silently continue.
  # check: entries are prose for a human, never executed.
  postcreate_records=$(wt_json_py records "$wt_json" postCreate); rc=$?
  [ "$rc" -eq 0 ] || exit 1
  checks_printed=""
  while IFS=$'\t' read -r kind value why required; do
    [ -n "$value" ] || continue
    if [ "$kind" = "check" ]; then
      [ -n "$checks_printed" ] || { echo "manual checks (not run):"; checks_printed=1; }
      if [ -n "$why" ]; then echo "  - $value ($why)"; else echo "  - $value"; fi
      continue
    fi
    out=$(cd "$root" && sh -c "$value" </dev/null 2>&1); cmdrc=$?
    if [ "$cmdrc" -eq 0 ]; then
      printf '%spostCreate '"'"'%s'"'"': ok%s\n' "$C_GREEN" "$value" "$C_RESET"
    else
      printf '%s\n' "$out" | tail -20
      printf '%spostCreate '"'"'%s'"'"': failed (exit %d)%s\n' "$C_RED" "$value" "$cmdrc" "$C_RESET" >&2
      [ -n "$why" ] && echo "why: $why" >&2
      exit 1
    fi
  done < <(printf '%s\n' "$postcreate_records")

  # Ignore check (from the main checkout, so it applies repo-wide).
  if git -C "$main" check-ignore -q .claude/worktrees; then
    echo "ignore: .claude/worktrees/ already excluded"
  else
    common=$(git -C "$main" rev-parse --git-common-dir)
    case "$common" in
      /*) : ;;
      *) common="$main/$common" ;;
    esac
    echo ".claude/worktrees/" >> "$common/info/exclude"
    echo "ignore: appended .claude/worktrees/ to $common/info/exclude"
  fi

  exit 0
}

cmd_baseline() {
  wt_json="$root/docs/architecture/worktree.json"
  records=""
  if [ -f "$wt_json" ]; then
    records=$(wt_json_py records "$wt_json" baseline); rc=$?
    [ "$rc" -eq 0 ] || exit 1
  fi
  if [ -z "$records" ]; then
    cat >&2 <<'EOF'
se baseline: no baseline entries in docs/architecture/worktree.json
add a top-level "baseline" list, e.g.:
  "baseline": [{"run": "npm test", "why": "..."}, {"run": "npm run lint"}]
EOF
    exit 1
  fi

  mkdir -p "$root/scratchpad"
  out_md="$root/scratchpad/baseline.md"
  branch=$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null)
  {
    printf '# Baseline\n\n'
    printf 'Date: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf 'Branch: %s\n' "$branch"
  } > "$out_md"

  checks_printed=""
  while IFS=$'\t' read -r kind value why required; do
    [ -n "$value" ] || continue
    if [ "$kind" = "check" ]; then
      [ -n "$checks_printed" ] || { echo "manual checks (not run):"; checks_printed=1; }
      if [ -n "$why" ]; then echo "  - $value ($why)"; else echo "  - $value"; fi
      continue
    fi
    start=$(date +%s)
    out=$(cd "$root" && sh -c "$value" </dev/null 2>&1); cmdrc=$?
    dur=$(( $(date +%s) - start ))
    tail_out=$(printf '%s\n' "$out" | tail -5)
    if [ "$cmdrc" -eq 0 ]; then
      printf '%sPASS %s (%ss)%s\n' "$C_GREEN" "$value" "$dur" "$C_RESET"
      { printf '\n## %s\n\nStatus: PASS\n' "$value"; } >> "$out_md"
    else
      printf '%sFAIL %s (exit %d, %ss)%s\n' "$C_RED" "$value" "$cmdrc" "$dur" "$C_RESET"
      [ -n "$why" ] && echo "why: $why"
      { printf '\n## %s\n\nStatus: FAIL (exit %d)\n' "$value" "$cmdrc"; } >> "$out_md"
      [ -n "$why" ] && { printf 'Why: %s\n' "$why"; } >> "$out_md"
    fi
    { printf 'Duration: %ss\n\n```\n%s\n```\n' "$dur" "$tail_out"; } >> "$out_md"
  done < <(printf '%s\n' "$records")

  echo "baseline -> scratchpad/baseline.md"
  exit 0
}

cmd_teardown() {
  name=${1:-}
  if [ -z "$name" ]; then
    printf '%sse teardown: usage: se teardown <name>%s\n' "$C_RED" "$C_RESET" >&2
    exit 1
  fi

  target="$main_checkout/.claude/worktrees/$name"

  registered=""
  for ((i = 0; i < ${#paths[@]}; i++)); do
    [ "${paths[$i]}" = "$target" ] && registered="yes" && branch=${branches[$i]}
  done
  if [ -z "$registered" ]; then
    printf '%sse teardown: %s is not a registered worktree (see: git worktree list)%s\n' "$C_RED" "$target" "$C_RESET" >&2
    exit 1
  fi

  cwd=$(pwd -P 2>/dev/null || pwd)
  case "$cwd" in
    "$target"|"$target"/*)
      printf '%sse teardown: refusing — the current directory is inside %s; cd out first%s\n' "$C_RED" "$target" "$C_RESET" >&2
      exit 1
      ;;
  esac

  dirty=$(git -C "$target" status --porcelain 2>/dev/null)
  if [ -n "$dirty" ]; then
    printf '%sse teardown: %s has uncommitted changes — refusing:%s\n' "$C_RED" "$target" "$C_RESET" >&2
    printf '%s\n' "$dirty" | sed 's/^/  /' >&2
    exit 1
  fi

  if [ "$branch" = "(detached)" ] || ! is_branch_merged "$branch"; then
    printf '%sse teardown: branch '"'"'%s'"'"' is not merged into %s — refusing%s\n' "$C_RED" "$branch" "$base" "$C_RESET" >&2
    exit 1
  fi

  target_json="$target/docs/architecture/worktree.json"

  # Gate: config-declared `copy` entries. A gitignored file with no git
  # history (secrets, local db snapshots) is irreplaceable once the
  # worktree is gone — refuse if one is here and either missing from main
  # or different from main's copy.
  copy_hits=()
  if [ -f "$target_json" ]; then
    copy_records=$(wt_json_py records "$target_json" copy); rc=$?
    [ "$rc" -eq 0 ] || exit 1
    while IFS=$'\t' read -r kind value why required; do
      [ "$kind" = "path" ] || continue
      [ -n "$value" ] || continue
      [ -e "$target/$value" ] || continue
      if [ ! -e "$main_checkout/$value" ]; then
        copy_hits+=("$value (absent from main)")
      elif ! cmp -s "$target/$value" "$main_checkout/$value"; then
        copy_hits+=("$value (differs from main)")
      fi
    done < <(printf '%s\n' "$copy_records")
  fi
  if [ "${#copy_hits[@]}" -gt 0 ]; then
    printf '%sse teardown: %s has config-declared files not safely replaceable from main — refusing:%s\n' \
      "$C_RED" "$target" "$C_RESET" >&2
    for ((i = 0; i < ${#copy_hits[@]}; i++)); do printf '  %s\n' "${copy_hits[$i]}" >&2; done
    echo "back these up (or delete them from the worktree if disposable), then re-run — se teardown never deletes them for you." >&2
    exit 1
  fi

  # Gate: any other gitignored file unique to this worktree. `git status
  # --porcelain` (the dirty gate above) never lists ignored files, so a
  # unique .dev.vars or a local *.db with no git history would otherwise be
  # destroyed silently. Rebuildable noise is excluded.
  ignored_hits=()
  sweep_tops=()
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    case "$rel" in ''|..*|/*) continue ;; esac
    if ! is_rebuildable "$rel" && [ ! -e "$main_checkout/$rel" ]; then
      ignored_hits+=("$rel")
      continue
    fi
    # Rebuildable, or local state the main checkout has too: disposable, but
    # git refuses to rmdir a non-empty directory, so it has to go first —
    # named out loud, never silently. Collect top-level entries so one rm
    # clears a whole node_modules instead of thousands.
    top=${rel%%/*}
    already=""
    for ((k = 0; k < ${#sweep_tops[@]}; k++)); do
      [ "${sweep_tops[$k]}" = "$top" ] && already=1 && break
    done
    [ -n "$already" ] || sweep_tops+=("$top")
  done < <(git -C "$target" ls-files --others --ignored --exclude-standard 2>/dev/null)
  if [ "${#ignored_hits[@]}" -gt 0 ]; then
    printf '%sse teardown: %s has unique gitignored files with no git history — refusing:%s\n' \
      "$C_RED" "$target" "$C_RESET" >&2
    for ((i = 0; i < ${#ignored_hits[@]}; i++)); do printf '  %s\n' "${ignored_hits[$i]}" >&2; done
    echo "back these up (or delete them from the worktree if disposable), then re-run — se teardown never deletes them for you." >&2
    exit 1
  fi

  # preDelete — from the TARGET's worktree.json, run inside the target.
  # check: entries are prose for a human, never executed.
  if [ -f "$target_json" ]; then
    predelete_records=$(wt_json_py records "$target_json" preDelete); rc=$?
    [ "$rc" -eq 0 ] || exit 1
    checks_printed=""
    while IFS=$'\t' read -r kind value why required; do
      [ -n "$value" ] || continue
      if [ "$kind" = "check" ]; then
        [ -n "$checks_printed" ] || { printf '%smanual checks (not run):%s\n' "$C_YELLOW" "$C_RESET"; checks_printed=1; }
        if [ -n "$why" ]; then echo "  - $value ($why)"; else echo "  - $value"; fi
        continue
      fi
      out=$(cd "$target" && sh -c "$value" </dev/null 2>&1); cmdrc=$?
      if [ "$cmdrc" -eq 0 ]; then
        echo "preDelete '$value': ok"
      else
        printf '%s\n' "$out" | tail -20
        printf '%spreDelete '"'"'%s'"'"': failed (exit %d)%s\n' "$C_RED" "$value" "$cmdrc" "$C_RESET" >&2
        [ -n "$why" ] && echo "why: $why" >&2
        exit 1
      fi
    done < <(printf '%s\n' "$predelete_records")
  fi

  # Clear the disposable ignored leftovers the gates above cleared as safe.
  # Without this `git worktree remove` dies on "Directory not empty" after
  # it has already unregistered the worktree, leaving an orphaned directory
  # and a half-done teardown.
  for ((i = 0; i < ${#sweep_tops[@]}; i++)); do
    t=${sweep_tops[$i]}
    [ -n "$t" ] && [ -e "$target/$t" ] || continue
    printf '%sclearing local state: %s%s\n' "$C_DIM" "$t" "$C_RESET"
    rm -rf "$target/${t:?}"
  done

  if ! git -C "$main_checkout" worktree remove "$target"; then
    printf '%sse teardown: git worktree remove failed for %s%s\n' "$C_RED" "$target" "$C_RESET" >&2
    if [ -d "$target" ] && [ ! -e "$target/.git" ]; then
      echo "git has already unregistered it, so what is left is an ordinary directory: inspect it, then 'rm -rf $target' and 'git -C $main_checkout worktree prune'." >&2
    fi
    exit 1
  fi
  printf '%sworktree removed: %s%s\n' "$C_GREEN" "$target" "$C_RESET"

  if ! git -C "$main_checkout" branch -d "$branch"; then
    printf '%sse teardown: git branch -d failed for %s%s\n' "$C_RED" "$branch" "$C_RESET" >&2
    exit 1
  fi
  printf '%sbranch deleted: %s%s\n' "$C_GREEN" "$branch" "$C_RESET"

  git -C "$main_checkout" worktree prune
  printf '%sworktree pruned%s\n' "$C_GREEN" "$C_RESET"

  exit 0
}

cmd_debt() {
  # Deterministic debt-marker ledger: `se-debt: <ceiling>, <upgrade trigger>`
  # left in a comment marks a deliberate shortcut. Only matched right after a
  # comment-ish prefix, so prose that merely talks about se-debt: is ignored.
  pattern='(#|//|--|;|\*|<!--)[[:space:]]*se-debt:'

  total=0 no_trigger=0
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    file=${hit%%:*}
    rest=${hit#*:}
    lineno=${rest%%:*}
    text=${rest#*:}
    marker=$(printf '%s\n' "$text" | sed -E 's/.*(se-debt:.*)/\1/')
    file=${file#./}
    total=$((total + 1))
    suffix=""
    case "$marker" in
      *,*) : ;;
      *) suffix=" ${C_YELLOW}[no-trigger]${C_RESET}"; no_trigger=$((no_trigger + 1)) ;;
    esac
    printf '%s:%s  %s%s\n' "$file" "$lineno" "$marker" "$suffix"
  done < <(cd "$root" && grep -rnEI \
    --exclude-dir=.git --exclude-dir=node_modules --exclude-dir=scratchpad \
    --exclude-dir=.claude --exclude-dir=dist --exclude-dir=build \
    --exclude=se \
    "$pattern" . 2>/dev/null)

  if [ "$total" -eq 0 ]; then
    printf '%sNo se-debt markers. Clean ledger.%s\n' "$C_GREEN" "$C_RESET"
  else
    printf '\n%s%d markers, %d without trigger.%s\n' "$C_BOLD" "$total" "$no_trigger" "$C_RESET"
  fi

  exit 0
}

case "${1:-status}" in
  status)   cmd_status ;;
  env)      cmd_env ;;
  baseline) cmd_baseline ;;
  teardown) cmd_teardown "${2:-}" ;;
  debt)     cmd_debt ;;
esac
